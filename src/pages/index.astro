---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<div class="hero__content">
					<h1 class="hero__name">Émile Savoie</h1>
					<h2 class="hero__title">Pianist &amp; Composer</h2>
					<p class="hero__quote">
						"Music for all."
					</p>
				</div>
				<div class="hero__scroll">Discover</div>
			</section>

			<section class="section">
				<div class="container-narrow" style="text-align: center;">
					<h2 style="margin-bottom: 2rem;">Welcome</h2>
					<p style="font-size: 1.15rem; line-height: 1.9;">
 						Music has always been my way of feeling deeply and expressing
  						honestly, through compositions and performances. Whether on
  						stage or in a classroom, I believe music can move us in ways
						that words alone cannot.
					</p>
					<a href="/portfolio" class="btn">View my portfolio</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
