---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const offerings = [
	{ icon: "♪", title: "Individual Lessons", desc: "Piano, flute, and recorder." },
	{ icon: "♫", title: "Composition & Theory", desc: "Musical writing, analysis, orchestration, counterpoint, and electroacoustics." },
	{ icon: "♬", title: "Exam Preparation", desc: "Preparation for RCM examinations. Theory, solfeggio, sight-reading, history, and musicology." },
	{ icon: "♩", title: "Online Lessons", desc: "Video conference sessions, flexible and accessible." },
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Teaching — Émile Savoie" description="Music lessons with Émile Savoie — piano, flute, composition, theory, and exam preparation. Individual and online lessons available in Montréal." />
	</head>
	<body>
		<Header />
		<main>
			<div class="page-header">
				<div class="container">
					<h1>Teaching</h1>
					<h2 class="page-header__subtitle">Sharing the passion for piano</h2>
				</div>
			</div>

			<section class="section" style="padding-top: 2rem;">
				<div class="container">
					<div class="teaching">
						<div class="teaching__info">
							<p>
								Teaching has always been a natural extension of my musical
								life. From my early years at the piano to my work as a
								teaching assistant at the University of Sherbrooke and Wilfrid
								Laurier University, I have guided students of all ages and
								levels.
							</p>
							<p>
								My approach emphasizes listening, patience, and the joy of
								playing. Every student is unique, and I adapt my method to
								your goals, whether you are discovering music for the first
								time or refining your craft.
							</p>

							<ul class="teaching__offerings">
								{offerings.map((item) => (
									<li>
										<span class="teaching__offering-icon">{item.icon}</span>
										<div class="teaching__offering-text">
											<h2>{item.title}</h2>
											<p>{item.desc}</p>
										</div>
									</li>
								))}
							</ul>

							<p style="font-size: 0.95rem; color: var(--color-muted); margin-top: 1.5rem; font-style: italic;">
								Repertoire specialties: baroque, classical, romantic, modern,
								jazz, and contemporary, including atonal, extended techniques,
								and experimental music.
							</p>

							<a href="/contact" class="btn">Contact me</a>
						</div>
						<div class="teaching__image">
							<img src="/images/emileteaching.webp" alt="Émile Savoie teaching piano" loading="lazy" />
						</div>
					</div>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
