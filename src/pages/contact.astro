---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Contact — Émile Savoie" description="Contact Émile Savoie for bookings, collaborations, or piano lessons." />
	</head>
	<body>
		<Header />
		<main>
			<div class="page-header">
				<div class="container">
					<h1>Contact</h1>
					<p class="page-header__subtitle">Bookings, Collaborations &amp; Teaching</p>
				</div>
			</div>

			<section class="section" style="padding-top: 2rem;">
				<div class="container">
					<div class="contact">
						<p style="font-size: 1.1rem; max-width: 600px; margin: 0 auto; line-height: 1.9;">
							For booking inquiries, collaborations, piano lessons, or simply
							to connect, feel free to reach out through any of the channels below.
						</p>

						<div class="contact__info">
							<div class="contact__item">
								<h3>Email</h3>
								<p><a href="mailto:music@emilesavoie.com">music@emilesavoie.com</a></p>
							</div>
														<div class="contact__item">
								<h3>Sheet Music</h3>
								<p>
									<a href="https://www.sheetmusicplus.com" target="_blank" rel="noopener">Sheet Music Plus</a> ·
									<a href="https://www.sheetmusicdirect.com" target="_blank" rel="noopener">Sheet Music Direct</a> ·
									<a href="https://www.harbridgewanless.com" target="_blank" rel="noopener">Harbridge &amp; Wanless Music</a>
								</p>
							</div>
							<div class="contact__item">
								<h3>Social Media</h3>
								<p>
									<a href="https://youtube.com/@emile4433?si=wLXeGkE_3AC5BFEK" target="_blank" rel="noopener">YouTube</a>
								</p>
							</div>
						</div>
					</div>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
