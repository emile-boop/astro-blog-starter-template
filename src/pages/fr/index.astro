---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<div class="hero__content">
					<h1 class="hero__name">Émile Savoie</h1>
					<p class="hero__title">Pianiste &amp; Compositeur</p>
					<p class="hero__quote">
						« La musique pour tous. »
					</p>
				</div>
				<div class="hero__scroll">Découvrir</div>
			</section>

			<section class="section">
				<div class="container-narrow" style="text-align: center;">
					<h2 style="margin-bottom: 2rem;">Bienvenue</h2>
					<p style="font-size: 1.15rem; line-height: 1.9;">
    					La musique a toujours été ma façon de ressentir les émotions plus
    					profondément et de m'exprimer sincèrement, à travers compositions
    					et interprétations. Que ce soit sur scène ou en classe, je crois
    					que la musique peut nous émouvoir d'une façon que n'y parviennent
    					pas les mots seuls.
					</p>
					<a href="/fr/portfolio" class="btn">Voir mon portfolio</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
