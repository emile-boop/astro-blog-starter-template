	{ title: "Jeu de soleil", year: "2025", instrumentation: "Piano", duration: "0:43" },
	{ title: "Promenade en forêt", year: "2025", instrumentation: "Piano", duration: "0:36" },
	{ title: "Tarantelle", year: "2025", instrumentation: "Piano", duration: "1:00" },
	{ title: "Pensée vagabonde", year: "2025", instrumentation: "Piano", duration: "0:40" },
	{ title: "Fantaisie québécoise", year: "2025", instrumentation: "Piano", duration: "5:14" },
	{ title: "La fervente", year: "2025", instrumentation: "Piano", duration: "0:30" },
	{ title: "Rêverie", year: "2025", instrumentation: "Piano", duration: "0:45" },
	{ title: "Berceuse", year: "2025", instrumentation: "Voix, flûte, violon, guitare, guzheng", duration: "2:34" },
	{ title: "12 canons faciles", year: "2025", instrumentation: "Piano", duration: "4:51" },
	{ title: "Bliss", year: "2025", instrumentation: "Lead Sheet", duration: "0:49" },
	{ title: "Last Wish", year: "2025", instrumentation: "Lead Sheet", duration: "0:52" },
	{ title: "Forks of Summer", year: "2025", instrumentation: "Lead Sheet", duration: "1:27" },
	{ title: "Sparkles of Time", year: "2025", instrumentation: "Lead Sheet", duration: "0:54" },
	// 2024
	{ title: "The Final Fanfare", year: "2024", instrumentation: "Trois trompettes, deux trombones, euphonium, tuba", duration: "2:39" },
	{ title: "Les nuages au-dessus de l'eau", year: "2024", instrumentation: "Instrumentation mixte (au moins deux interprètes)", duration: "1:50" },
	// 2023
	{ title: "She Wants To Cry", year: "2023", instrumentation: "Électroacoustique", duration: "7:11" },
	{ title: "Invention en do mineur", year: "2023", instrumentation: "Piano", duration: "1:29" },
	// 2022
	{ title: "Rites Nocturnes", year: "2022", instrumentation: "Orchestre à vent", duration: "13:32", movements: "Mouvements 1 & 2" },
	{ title: "Prélude Nº 1", year: "2022", instrumentation: "Piano", duration: "1:55" },
	{ title: "La Dernière Épreuve", year: "2022", instrumentation: "Orchestre symphonique", duration: "1:33" },
	{ title: "Aventure et Combats", year: "2022", instrumentation: "Orchestre symphonique", duration: "1:51" },
	{ title: "L'Île", year: "2022", instrumentation: "Orchestre symphonique", duration: "2:14" },
	{ title: "Encre d'écorce", year: "2022", instrumentation: "Flûte, violon, violoncelle, piano", duration: "2:47" },
	{ title: "Deuil", year: "2022", instrumentation: "Quintette à cordes", duration: "2:21" },
	{ title: "L'arrivée du train", year: "2022", instrumentation: "Orchestre à cordes", duration: "1:27" },
	{ title: "Duo du Bic", year: "2022", instrumentation: "Alto, violoncelle", duration: "2:36" },
	{ title: "Sorcellerie", year: "2022", instrumentation: "Orchestre symphonique", duration: "1:55" },
	{ title: "Quintette à cordes Nº1", year: "2022", instrumentation: "Deux violons, alto, violoncelle, contrebasse", duration: "2:03" },
	// 2021
	{ title: "Marche en Nouvelle Terre", year: "2021", instrumentation: "Orchestre symphonique", duration: "0:54" },
	{ title: "Avancement", year: "2021", instrumentation: "Orchestre à vent", duration: "1:22" },
	{ title: "Concertino pour caisse claire, grosse caisse et marimba", year: "2021", instrumentation: "Orchestre à vent", duration: "4:01", movements: "Mouvement 1" },
	{ title: "Concerto pour piano Nº 4", year: "2021", instrumentation: "Piano, orchestre symphonique", duration: "6:50", movements: "Mouvement 1" },
	{ title: "Morts inquiets", year: "2021", instrumentation: "SATB + piano", duration: "4:34" },
	{ title: "Menus Félins", year: "2021", instrumentation: "SATB + piano", duration: "4:57", movements: "Mouvements 1 & 2" },
	{ title: "Une autre tombe", year: "2021", instrumentation: "Piano, voix", duration: "2:40" },
	{ title: "Sonate en trio", year: "2021", instrumentation: "Flûte, violon, basse continue", duration: "2:07", movements: "Mouvement 1" },
	// 2020
	{ title: "TEG", year: "2020", instrumentation: "Électroacoustique", duration: "3:40" },
	{ title: "Libération", year: "2020", instrumentation: "Piano, flûte", duration: "2:19" },
	{ title: "Impromptu Nº 1", year: "2020", instrumentation: "Piano", duration: "1:40" },
	{ title: "Scherzo Nº 2", year: "2020", instrumentation: "Piano", duration: "6:19" },
	{ title: "Adagio pour flûte et piano", year: "2020", instrumentation: "Piano, flûte", duration: "2:56" },
	{ title: "Esperluète", year: "2020", instrumentation: "Flûte, clarinette en si♭, violon, violoncelle, timbales", duration: "1:13" },
	{ title: "A Little Groove", year: "2020", instrumentation: "Trompette, saxophone alto, saxophone ténor, saxophone baryton, trombone ténor, piano, guitare électrique, guitare basse, batterie", duration: "2:19" },
	{ title: "La pensée d'une vie", year: "2020", instrumentation: "Quatuor à cordes", duration: "2:42" },
	{ title: "Sonatine classique", year: "2020", instrumentation: "Piano", duration: "3:06", movements: "Mouvement 1" },
	{ title: "Allemande & Corrente", year: "2020", instrumentation: "Flûte, violon, basse continue", duration: "3:51" },
	{ title: "Parade fantasque", year: "2020", instrumentation: "Clarinette en si♭, violoncelle", duration: "2:05" },
	{ title: "Pour un autre temps", year: "2020", instrumentation: "Guitare classique", duration: "4:27" },
	// 2019
	{ title: "Quintette de cuivres Nº1", year: "2019", instrumentation: "Deux trompettes, cor en fa, trombone, tuba", duration: "3:10" },
	{ title: "Appartrio", year: "2019", instrumentation: "Trois flûtes", duration: "6:14", movements: "Mouvements 1 & 2" },
	{ title: "Marche pour flûte et piano", year: "2019", instrumentation: "Piano, flûte", duration: "1:45" },
	{ title: "Suite pour piano", year: "2019", instrumentation: "Piano", duration: "1:36", movements: "Mouvement 1" },
	// 2018
	{ title: "Toccate", year: "2018", instrumentation: "Clavecin/piano", duration: "2:16" },
	{ title: "Trois mouvements pour flûte et piano", year: "2018", instrumentation: "Piano, flûte", duration: "2:55" },
	// 2017
	{ title: "Pour Lise", year: "2017", instrumentation: "Orchestre symphonique", duration: "1:52" },
	// 2015
	{ title: "Au cœur des ténèbres", year: "2015", instrumentation: "Deux flûtes, hautbois, cor en fa, basson, violoncelle, piano", duration: "1:37" },
	// 2014
	{ title: "Moments musicaux", year: "2014", instrumentation: "Piano, flûte", duration: "1:06" },
	{ title: "Pris", year: "2014", instrumentation: "Clavecin, flûte à bec", duration: "2:57", movements: "Composé 2013–2014" },
	// 2013
	{ title: "Brindille", year: "2013", instrumentation: "Deux flûtes", duration: "0:33" },
	{ title: "Course", year: "2013", instrumentation: "Basson, euphonium", duration: "0:52" },
];

// Grouper par année (déjà trié du plus récent au plus ancien)
const compositionsByYear = [];
let currentYear = null;
let currentGroup = null;
for (const c of compositions) {
	if (c.year !== currentYear) {
		currentYear = c.year;
		currentGroup = { year: c.year, works: [] };
		compositionsByYear.push(currentGroup);
	}
	currentGroup.works.push(c);
}

const concerts = [
	{ year: "2025", title: "Cycles", role: "Concert de musique classique contemporaine", venue: "Maureen Forrester Recital Hall" },
	{ year: "2025–2026", title: "Concert des chœurs de Laurier", role: "Pianiste accompagnateur", venue: "Maureen Forrester Recital Hall" },
	{ year: "2025", title: "All That Worldly Jazz Festival", role: "Interprétation en piano solo", venue: "St. Jacobs Village" },
	{ year: "2025", title: "Keeper of Songs and Secrets", role: "Interprétation contemporaine", venue: "Crawford Lake Conservation Area" },
	{ year: "2025", title: "Prometheus", role: "Concert multidisciplinaire", venue: "Maureen Forrester Recital Hall" },
	{ year: "2025", title: "Of Mothers and Daughters", role: "Concert NUMUS", venue: "Kitchener-Waterloo Little Theatre" },
];

const discography = [
	{
		title: "Préludes d'automne",
		year: "2024",
		desc: "Recueil de préludes pour piano solo, enregistré en studio.",
		tracks: [
			{ name: "Prélude n°1 — Feuilles", duration: "3:42" },
			{ name: "Prélude n°2 — Brume", duration: "4:15" },
			{ name: "Prélude n°3 — Première neige", duration: "5:08" },
			{ name: "Prélude n°4 — Crépuscule", duration: "3:56" },
		],
	},
	{
		title: "Études-tableaux",
		year: "2023",
		desc: "Six études pour piano, exploration de la virtuosité expressive.",
		tracks: [
			{ name: "Étude n°1 — Allegro", duration: "4:20" },
			{ name: "Étude n°2 — Andante", duration: "5:33" },
			{ name: "Étude n°3 — Presto", duration: "3:18" },
			{ name: "Étude n°4 — Largo", duration: "6:45" },
		],
	},
	{
		title: "Sonate pour violon et piano",
		year: "2022",
		desc: "Sonate en trois mouvements, enregistrée avec violoniste invité.",
		tracks: [
			{ name: "I. Allegro moderato", duration: "8:12" },
			{ name: "II. Andante", duration: "6:30" },
			{ name: "III. Allegro vivace", duration: "7:45" },
		],
	},
];
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead title="Portfolio — Émile Savoie" description="Œuvres, concerts et enregistrements d'Émile Savoie, pianiste et compositeur." />
	</head>
	<body>
		<Header />
		<main>
			<div class="page-header">
				<div class="container">
					<h1>Portfolio</h1>
					<p class="page-header__subtitle">Œuvres, Concerts &amp; Enregistrements</p>
				</div>
			</div>

			<section class="section" style="padding-top: 1rem;">
				<div class="container">
					<ul class="portfolio__tabs">
						<li><button class="portfolio__tab active" data-target="oeuvres">Œuvres / Compositions</button></li>
						<li><button class="portfolio__tab" data-target="concerts">Concerts / Événements</button></li>
						<li><button class="portfolio__tab" data-target="enregistrements">Discographie / Enregistrements</button></li>
					</ul>

					<div id="oeuvres" class="portfolio__section">
						<h2 class="portfolio__section-title">Œuvres / Compositions</h2>
						<p class="portfolio__section-desc">Catalogue d'œuvres originales — {compositions.length} compositions (2013–2026).</p>

						<div class="works-catalogue">
							{compositionsByYear.map((group) => (
								<div class="works-year-group">
									<h3 class="works-year">{group.year}</h3>
									<table class="works-table">
										<thead>
											<tr>
												<th class="works-table__col-title">Titre</th>
												<th class="works-table__col-inst">Instrumentation</th>
												<th class="works-table__col-dur">Durée</th>
											</tr>
										</thead>
										<tbody>
											{group.works.map((work) => (
												<tr>
													<td class="works-table__title">
														{work.title}
														{work.movements && <span class="works-table__mvt">{work.movements}</span>}
													</td>
													<td class="works-table__inst">{work.instrumentation}</td>
													<td class="works-table__dur">{work.duration}</td>
												</tr>
											))}
										</tbody>
									</table>
								</div>
							))}
						</div>
					</div>

							<div id="concerts" class="portfolio__section">
					<h2 class="portfolio__section-title">Concerts / Événements</h2>
					<p class="portfolio__section-desc">Prochaines représentations et événements à venir.</p>
					<ul class="concerts-list">
						{concerts.map((concert) => (
							<li class="concert-item">
								<div class="concert-item__date">
									<span class="concert-item__date-day">{concert.day}</span>
									<span class="concert-item__date-month">{concert.month}</span>
								</div>
								<div class="concert-item__details">
									<h3>{concert.title}</h3>
									<p class="concert-item__venue">{concert.venue}</p>
								</div>
								<a href="/fr/contact" class="concert-item__link">Réserver →</a>
							</li>
						))}
					</ul>
				</div>

					<div id="enregistrements" class="portfolio__section">
						<h2 class="portfolio__section-title">Discographie / Enregistrements</h2>
						<p class="portfolio__section-desc">Albums et projets enregistrés en studio.</p>
						{discography.map((album) => (
							<div class="discography-item">
								<div class="discography-item__cover">
									<img src="/images/album-placeholder.jpg" alt={album.title} loading="lazy" />
								</div>
								<div class="discography-item__info">
									<h3>{album.title}</h3>
									<p class="discography-item__year">{album.year}</p>
									<p>{album.desc}</p>
									<ul class="discography-item__tracks">
										{album.tracks.map((track, i) => (
											<li>
												<span><span class="track-number">{String(i + 1).padStart(2, '0')}.</span> {track.name}</span>
												<span>{track.duration}</span>
											</li>
										))}
									</ul>
								</div>
							</div>
						))}
					</div>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	/* === Catalogue des œuvres — tableaux par année, colonnes alignées === */
	.works-catalogue {
		margin-top: 2rem;
	}

	.works-year-group {
		margin-bottom: 3rem;
	}

	.works-year {
		font-family: var(--font-serif, Georgia, serif);
		font-size: 1.6rem;
		color: var(--color-accent, #6b5b4a);
		margin-bottom: 1rem;
		padding-bottom: 0.5rem;
		border-bottom: 1px solid var(--color-border, #e5e0d8);
	}

	.works-table {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.95rem;
		table-layout: fixed;
	}

	/* Mêmes largeurs de colonnes sur chaque tableau → alignement parfait */
	.works-table__col-title { width: 32%; }
	.works-table__col-inst   { width: 51%; }
	.works-table__col-dur    { width: 17%; }

	.works-table thead th {
		font-family: var(--font-sans, sans-serif);
		font-size: 0.75rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--color-text-muted, #888);
		font-weight: 400;
		text-align: left;
		padding: 0.75rem 1rem;
		border-bottom: 1px solid var(--color-border, #e5e0d8);
	}

	.works-table thead th.works-table__col-dur {
		text-align: right;
	}

	.works-table tbody tr {
		border-bottom: 1px solid var(--color-border, #e5e0d8);
		transition: background-color 0.2s ease;
	}

	.works-table tbody tr:hover {
		background-color: rgba(107, 91, 74, 0.04);
	}

	.works-table td {
		padding: 1rem;
		vertical-align: top;
		line-height: 1.5;
	}

	.works-table__title {
		font-family: var(--font-serif, Georgia, serif);
		font-size: 1.05rem;
		color: var(--color-text, #1a1a1a);
	}

	.works-table__mvt {
		display: block;
		font-family: var(--font-sans, sans-serif);
		font-size: 0.8rem;
		font-style: italic;
		color: var(--color-text-muted, #888);
		margin-top: 0.15rem;
	}

	.works-table__inst {
		color: var(--color-text-soft, #555);
		font-size: 0.9rem;
	}

	.works-table__dur {
		color: var(--color-text-muted, #888);
		font-size: 0.9rem;
		text-align: right;
	}

	/* Responsive */
	@media (max-width: 700px) {
		.works-table thead {
			display: none;
		}

		.works-table,
		.works-table tbody,
		.works-table tr,
		.works-table td {
			display: block;
			width: 100%;
		}

		.works-table tbody tr {
			padding: 1rem 0;
			border-bottom: 1px solid var(--color-border, #e5e0d8);
		}

		.works-table td {
			padding: 0.15rem 0;
			border: none;
		}

		.works-table__title {
			font-size: 1.1rem;
		}

		.works-table__inst::before {
			content: 'Instrumentation : ';
			font-size: 0.8rem;
			text-transform: uppercase;
			letter-spacing: 0.05em;
			color: var(--color-text-muted, #888);
		}

		.works-table__dur {
			text-align: left;
		}

		.works-table__dur::before {
			content: 'Durée : ';
			font-size: 0.8rem;
			text-transform: uppercase;
			letter-spacing: 0.05em;
			color: var(--color-text-muted, #888);
		}
	}
</style>

<script>
	const tabs = document.querySelectorAll('.portfolio__tab');
	const sections = document.querySelectorAll('.portfolio__section');

	tabs.forEach((tab) => {
		tab.addEventListener('click', () => {
			const target = document.getElementById(tab.dataset.target);
			if (target) {
				target.scrollIntoView({ behavior: 'smooth', block: 'start' });
			}
		});
	});

	const observer = new IntersectionObserver(
		(entries) => {
			entries.forEach((entry) => {
				if (entry.isIntersecting) {
					const id = entry.target.id;
					tabs.forEach((t) => {
						t.classList.toggle('active', t.dataset.target === id);
					});
				}
			});
		},
		{ rootMargin: '-30% 0px -50% 0px' }
	);

	sections.forEach((s) => observer.observe(s));
</script>
