---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const offerings = [
	{ icon: "♪", title: "Cours individuels", desc: "Piano, flûte traversière et flûte à bec." },
	{ icon: "♫", title: "Composition et théorie", desc: "Écriture musicale, analyse, orchestration, contrepoint et électroacoustique." },
	{ icon: "♬", title: "Préparation aux examens", desc: "Préparation aux examens du RCM. Théorie, solfège, lecture à vue, histoire et musicologie." },
	{ icon: "♩", title: "Cours en ligne", desc: "Sessions par visioconférence, flexibles et accessibles." },
];
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead title="Enseignement — Émile Savoie" description="Cours de musique avec Émile Savoie — piano, flûte, composition, théorie et préparation aux examens. Cours individuels et en ligne à Montréal." />
	</head>
	<body>
		<Header />
		<main>
			<div class="page-header">
				<div class="container">
					<h1>Enseignement</h1>
					<h2 class="page-header__subtitle">Transmettre la passion du piano</h2>
				</div>
			</div>

			<section class="section" style="padding-top: 2rem;">
				<div class="container">
					<div class="teaching">
						<div class="teaching__info">
							<p>
								L'enseignement a toujours été un prolongement naturel de ma
								vie musicale. De mes premières années au piano à mon travail
								comme assistant d'enseignement à l'Université de Sherbrooke
								et à l'Université Wilfrid Laurier, j'ai accompagné des élèves
								de tous âges et de tous niveaux.
							</p>
							<p>
								Mon approche privilégie l'écoute, la patience et le plaisir de
								jouer. Chaque élève est unique, et j'adapte ma méthode à vos
								objectifs, qu'il s'agisse de découvrir la musique pour la
								première fois ou de perfectionner votre jeu.
							</p>

							<ul class="teaching__offerings">
								{offerings.map((item) => (
									<li>
										<span class="teaching__offering-icon">{item.icon}</span>
										<div class="teaching__offering-text">
											<h2>{item.title}</h2>
											<p>{item.desc}</p>
										</div>
									</li>
								))}
							</ul>

							<p style="font-size: 0.95rem; color: var(--color-muted); margin-top: 1.5rem; font-style: italic;">
								Spécialités du répertoire : baroque, classique, romantique,
								moderne, jazz et contemporain, incluant atonal, techniques
								étendues et musique expérimentale.
							</p>

							<a href="/fr/contact" class="btn">Me contacter</a>
						</div>
						<div class="teaching__image">
							<img src="/images/emileteaching.webp" alt="Émile Savoie enseignant le piano" loading="lazy" />
						</div>
					</div>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
