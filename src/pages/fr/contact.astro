---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead title="Contact — Émile Savoie" description="Contactez Émile Savoie pour réservations, collaborations ou cours de piano." />
	</head>
	<body>
		<Header />
		<main>
			<div class="page-header">
				<div class="container">
					<h1>Contact</h1>
					<p class="page-header__subtitle">Réservations, Collaborations &amp; Enseignement</p>
				</div>
			</div>

			<section class="section" style="padding-top: 2rem;">
				<div class="container">
					<div class="contact">
						<p style="font-size: 1.1rem; max-width: 600px; margin: 0 auto; line-height: 1.9;">
							Pour toute demande de réservation, collaboration, cours de piano ou
							simplement pour échanger, n'hésitez pas à me contacter par l'un des
							moyens ci-dessous.
						</p>

						<div class="contact__info">
							<div class="contact__item">
								<h3>Email</h3>
								<p><a href="mailto:contact@emilesavoie.com">contact@emilesavoie.com</a></p>
							</div>
							<div class="contact__item">
								<h3>Téléphone</h3>
								<p><a href="tel:+10000000000">+1 (000) 000-0000</a></p>
							</div>
							<div class="contact__item">
								<h3>Réseaux sociaux</h3>
								<p>
									<a href="https://www.youtube.com" target="_blank" rel="noopener">YouTube</a> ·
									<a href="https://www.instagram.com" target="_blank" rel="noopener">Instagram</a> ·
									<a href="https://www.spotify.com" target="_blank" rel="noopener">Spotify</a>
								</p>
							</div>
						</div>
					</div>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
