---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="About — Émile Savoie" description="Biography of Émile Savoie, pianist and composer." />
	</head>
	<body>
		<Header />
		<main>
			<div class="page-header">
				<div class="container">
					<h1>About</h1>
					<p class="page-header__subtitle">Pianist &amp; Composer</p>
				</div>
			</div>

			<section class="section" style="padding-top: 2rem;">
				<div class="container">
					<div class="about">
						<div class="about__image">
							<img src="/images/about-placeholder.jpg" alt="Émile Savoie at the piano" loading="lazy" />
						</div>
						<div class="about__text">
							<p>
								Born in Québec, Émile Savoie developed a deep attachment to the
								piano and composition from an early age. Trained under renowned
								masters, he refined his musical language at the crossroads of
								classical repertoire and contemporary writing.
							</p>
							<p>
								His work as a composer is driven by a pursuit of simplicity and
								clarity — every note has its place, every silence has its
								meaning. His works have been performed in several concert halls
								and festivals, both in Canada and internationally.
							</p>
							<p>
								Alongside his career as a performer and composer, Émile is
								dedicated to teaching, passing on to new generations the joy
								and rigor of the pianistic art.
							</p>

							<div class="about__highlights">
								<div class="about__highlight">
									<span class="about__highlight-number">10+</span>
									<span class="about__highlight-label">Years of career</span>
								</div>
								<div class="about__highlight">
									<span class="about__highlight-number">50+</span>
									<span class="about__highlight-label">Concerts performed</span>
								</div>
								<div class="about__highlight">
									<span class="about__highlight-number">250+</span>
									<span class="about__highlight-label">Original compositions</span>
								</div>
							</div>
						</div>
					</div>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
