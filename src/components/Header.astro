---
import HeaderLink from './HeaderLink.astro';

const pathname = Astro.url.pathname;
const isFr = pathname.startsWith('/fr');

const links = isFr
  ? [
      { href: '/fr/', label: 'Accueil' },
      { href: '/fr/about', label: 'À propos' },
      { href: '/fr/portfolio', label: 'Portfolio' },
      { href: '/fr/teaching', label: 'Enseignement' },
      { href: '/fr/contact', label: 'Contact' },
    ]
  : [
      { href: '/', label: 'Home' },
      { href: '/about', label: 'About' },
      { href: '/portfolio', label: 'Portfolio' },
      { href: '/teaching', label: 'Teaching' },
      { href: '/contact', label: 'Contact' },
    ];

const enToFr: Record<string, string> = {
  '/': '/fr/',
  '/about': '/fr/about',
  '/portfolio': '/fr/portfolio',
  '/teaching': '/fr/teaching',
  '/contact': '/fr/contact',
};

const frToEn: Record<string, string> = {
  '/fr/': '/',
  '/fr/about': '/about',
  '/fr/portfolio': '/portfolio',
  '/fr/teaching': '/teaching',
  '/fr/contact': '/contact',
};

const langHref = isFr ? frToEn[pathname] ?? '/' : enToFr[pathname] ?? '/fr/';
---

<header>
  <nav>
    <h2>
      <a href={isFr ? '/fr/' : '/'}>Émile Savoie</a>
    </h2>
    <ul class="internal-links" id="nav-links">
      {links.map((link) => (
        <li>
          <HeaderLink href={link.href}>{link.label}</HeaderLink>
        </li>
      ))}
    </ul>
    <div class="nav-actions">
      <a href={langHref} class="lang-switch" aria-label={isFr ? 'Switch to English' : 'Passer en français'}>
        {isFr ? 'EN' : 'FR'}
      </a>
      <button class="nav-toggle" id="nav-toggle" aria-label="Menu" aria-expanded="false">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </nav>
</header>

<style>
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }
  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    cursor: pointer;
    background: none;
    border: none;
    padding: 0;
  }
  .nav-toggle span {
    width: 24px;
    height: 1px;
    background-color: var(--color-text);
    transition: 0.3s;
  }
  @media (max-width: 900px) {
    .nav-toggle {
      display: flex;
    }
  }
</style>

<script>
  const toggle = document.getElementById('nav-toggle');
  const links = document.getElementById('nav-links');
  toggle?.addEventListener('click', () => {
    const isOpen = links?.classList.toggle('open');
    toggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
  });
</script>
