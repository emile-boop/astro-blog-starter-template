---
import HeaderLink from './HeaderLink.astro';

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const isFr = pathname.startsWith('/fr');

const links = isFr
  ? [
      { href: '/fr/', label: 'Accueil' },
      { href: '/fr/biography', label: 'Biographie' },
      { href: '/fr/portfolio', label: 'Portfolio' },
      { href: '/fr/teaching', label: 'Enseignement' },
      { href: '/fr/contact', label: 'Contact' },
    ]
  : [
      { href: '/', label: 'Home' },
      { href: '/biography', label: 'Biography' },
      { href: '/portfolio', label: 'Portfolio' },
      { href: '/teaching', label: 'Teaching' },
      { href: '/contact', label: 'Contact' },
    ];

// Calcul automatique du lien de changement de langue
let langHref;
if (isFr) {
  langHref = pathname.replace(/^\/fr/, '') || '/';
} else {
  langHref = pathname === '/' ? '/fr/' : '/fr' + pathname;
}
---

<header>
  <div class="construction-banner">
    {isFr
      ? '⚠️ Site en construction — Certaines informations peuvent être inexactes.'
      : '⚠️ Website under construction — Some information may be inaccurate.'}
  </div>
  <nav>
    <h2>
  <a href={isFr ? '/fr/' : '/'} class="nav__logo-link">
    <img src="/images/logo.png" alt="Émile Savoie" class="nav__logo" />
    <span>Émile Savoie</span>
  </a>
    </h2>
    <ul class="internal-links" id="nav-links">
      {links.map((link) => (
        <li>
          <HeaderLink href={link.href}>{link.label}</HeaderLink>
        </li>
      ))}
    </ul>
    <div class="nav-actions">
      <a href={langHref} class="lang-switch" aria-label={isFr ? 'Switch to English' : 'Passer en français'}>
        {isFr ? 'EN' : 'FR'}
      </a>
      <button class="nav-toggle" id="nav-toggle" aria-label="Menu" aria-expanded="false">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </nav>
</header>

<style>
  .construction-banner {
    background-color: #6b5b4a;
    color: #fff;
    text-align: center;
    padding: 0.5rem 1rem;
    font-size: 0.8rem;
    letter-spacing: 0.05em;
  }
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }
  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    cursor: pointer;
    background: none;
    border: none;
    padding: 0;
  }
  .nav-toggle span {
    width: 24px;
    height: 1px;
    background-color: var(--color-text);
    transition: 0.3s;
  }
  @media (max-width: 900px) {
    .nav-toggle {
      display: flex;
    }
  }
</style>

<script>
  const toggle = document.getElementById('nav-toggle');
  const links = document.getElementById('nav-links');
  toggle?.addEventListener('click', () => {
    const isOpen = links?.classList.toggle('open');
    toggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
  });
</script>
