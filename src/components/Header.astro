---
import HeaderLink from './HeaderLink.astro';

const pathname = Astro.url.pathname;
const isEn = pathname.startsWith('/en');

const links = isEn
  ? [
      { href: '/en/', label: 'Home' },
      { href: '/en/about', label: 'About' },
      { href: '/en/portfolio', label: 'Portfolio' },
      { href: '/en/teaching', label: 'Teaching' },
      { href: '/en/contact', label: 'Contact' },
    ]
  : [
      { href: '/', label: 'Accueil' },
      { href: '/about', label: 'À propos' },
      { href: '/portfolio', label: 'Portfolio' },
      { href: '/teaching', label: 'Enseignement' },
      { href: '/contact', label: 'Contact' },
    ];

const frToEn: Record<string, string> = {
  '/': '/en/',
  '/about': '/en/about',
  '/portfolio': '/en/portfolio',
  '/teaching': '/en/teaching',
  '/contact': '/en/contact',
};

const enToFr: Record<string, string> = {
  '/en/': '/',
  '/en/about': '/about',
  '/en/portfolio': '/portfolio',
  '/en/teaching': '/teaching',
  '/en/contact': '/contact',
};

const langHref = isEn ? enToFr[pathname] ?? '/' : frToEn[pathname] ?? '/en/';
---

<header>
  <nav>
    <h2>
      <a href={isEn ? '/en/' : '/'}>Émile Savoie</a>
    </h2>
    <ul class="internal-links" id="nav-links">
      {links.map((link) => (
        <li>
          <HeaderLink href={link.href}>{link.label}</HeaderLink>
        </li>
      ))}
    </ul>
    <div class="nav-actions">
      <a href={langHref} class="lang-switch" aria-label={isEn ? 'Passer en français' : 'Switch to English'}>
        {isEn ? 'FR' : 'EN'}
      </a>
      <button class="nav-toggle" id="nav-toggle" aria-label="Menu" aria-expanded="false">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </nav>
</header>

<style>
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }
  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    cursor: pointer;
    background: none;
    border: none;
    padding: 0;
  }
  .nav-toggle span {
    width: 24px;
    height: 1px;
    background-color: var(--color-text);
    transition: 0.3s;
  }
  @media (max-width: 900px) {
    .nav-toggle {
      display: flex;
    }
  }
</style>

<script>
  const toggle = document.getElementById('nav-toggle');
  const links = document.getElementById('nav-links');
  toggle?.addEventListener('click', () => {
    const isOpen = links?.classList.toggle('open');
    toggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
  });
</script>
