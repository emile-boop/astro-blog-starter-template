---
import { SEO } from "astro-seo";

interface Props {
	title: string;
	description?: string;
	image?: string;
}

const {
	title,
	description = "Émile Savoie — Pianist & Composer",
	image = "/default-og-image.png",
} = Astro.props;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />

<!-- Font preloads -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
	href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Jost:wght@300;400;500&display=swap"
	rel="stylesheet"
/>

<!-- Override font variables to use Google Fonts -->
<style is:global>
	:root {
		--font-serif: "Cormorant Garamond", Georgia, "Times New Roman", serif !important;
		--font-body: "Jost", "Helvetica Neue", Arial, sans-serif !important;
	}
</style>

<!-- SEO -->
<SEO
	title={title}
	description={description}
	openGraph={{
		title,
		description,
		type: "website",
		url: "https://emilesavoie.com",
		images: [{ url: image }],
	}}
	twitter={{
		card: "summary_large_image",
		title,
		description,
	}}
	canonical="https://emilesavoie.com"
/>
