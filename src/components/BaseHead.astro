---
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
	image?: string;
}

const {
	title,
	description = "Émile Savoie — Pianist & Composer",
	image = "/images/emilesavoieog.webp",
} = Astro.props;

const rawPath = Astro.url.pathname;
const pathname = rawPath.endsWith('/') ? rawPath : rawPath + '/';
const canonical = new URL(pathname, Astro.site || 'https://emilesavoie.com').toString();

const isFr = pathname.startsWith('/fr/');
const basePath = isFr ? pathname.replace(/^\/fr/, '') : pathname;
const enUrl = new URL(basePath, 'https://emilesavoie.com').toString();
const frUrl = new URL('/fr' + basePath, 'https://emilesavoie.com').toString();
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" type="image/png" href="/images/logoblanc.png" />
<link rel="icon" type="image/svg+xml" href="/images/logoblanc.svg" />
<meta name="generator" content={Astro.generator} />

<!-- SEO Meta Tags -->
<title>{title} — Émile Savoie</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

<!-- Hreflang (bilingual) -->
<link rel="alternate" hreflang="en" href={enUrl} />
<link rel="alternate" hreflang="fr" href={frUrl} />
<link rel="alternate" hreflang="x-default" href={enUrl} />

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Émile Savoie" />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content="Pianist, composer, and music teacher based in Montréal. Explore his compositions and performances." />
<meta property="og:image" content={image} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />

<!-- Google Analytics -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-W643R8NPXF" is:inline></script>
<script is:inline>
	window.dataLayer = window.dataLayer || [];
	function gtag(){dataLayer.push(arguments);}
	gtag('js', new Date());
	gtag('config', 'G-W643R8NPXF');
</script>

<!-- Structured Data (JSON-LD) -->
<script type="application/ld+json" is:inline>
{
	"@context": "https://schema.org",
	"@type": "Person",
	"name": "Émile Savoie",
	"jobTitle": "Pianist and Composer",
	"url": "https://emilesavoie.com",
	"image": "https://emilesavoie.com/images/emilesavoie.webp",
	"sameAs": [
		"https://www.youtube.com/@emile4433"
	]
}
</script>
